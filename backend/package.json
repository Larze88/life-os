{
  "name": "@lifeos/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "@lifeos/shared": "*",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.21",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
