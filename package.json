{
  "name": "life-os",
  "private": true,
  "version": "0.4.1",
  "description": "Private, self-hosted daily tracking PWA",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "preinstall": "node scripts/check-node.cjs",
    "predev": "node scripts/check-node.cjs",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,magenta \"npm:dev -w @lifeos/backend\" \"npm:dev -w @lifeos/frontend\"",
    "build": "npm run build -w @lifeos/frontend && npm run build -w @lifeos/backend",
    "start": "npm run start -w @lifeos/backend",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "npm run db:generate -w @lifeos/backend",
    "db:migrate": "npm run db:migrate -w @lifeos/backend",
    "check": "npm run typecheck && npm run lint && npm run test",
    "phone": "npm run build && node scripts/start-local.mjs",
    "start:local": "node scripts/start-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
